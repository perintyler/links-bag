{
  "name": "@barry-rocks/sdk-links",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Link bookmarking — Cloudflare Worker + Durable Object + browser UI",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./styles": "./src/styles.css",
    "./css": "./dist/css.js",
    "./browser": "./dist/browser.js",
    "./browser-inline": "./dist/browser-inline.js",
    "./worker": "./src/worker/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260819.1",
    "esbuild": "0.27.0",
    "typescript": "5.9.3",
    "wrangler": "4.113.0"
  }
